="""算术表达式的表示、求值、输出与判重。

题目中的表达式是二叉树：叶子结点是操作数，内部结点是运算符。用树而不是字符串来
表示，带来三个好处：

1. 求值只需递归，不必反复解析字符串；
2. 输出时可以根据运算符优先级决定是否需要补括号，保证打印出来的式子与树同义；
3. 判重时可以对 ``+``、``×`` 的左右子树做归一化排序，得到一棵表达式在“交换律”意义
   下的唯一表示。
"""

from __future__ import annotations

import re
from dataclasses import dataclass
from fractions import Fraction

from .number import format_number, parse_number

ADD, SUB, MUL, DIV = "+", "−", "×", "÷"
OPERATORS = (ADD, SUB, MUL, DIV)

# 运算符优先级：加减为 1，乘除为 2。输出时用来决定是否补括号。
PRECEDENCE = {ADD: 1, SUB: 1, MUL: 2, DIV: 2}


@dataclass(frozen=True)
class Expression:
    """表达式二叉树的结点。``op`` 为 None 时是叶子结点，此时 ``value`` 为操作数。

    ``value`` 在构造时就算好并挂在结点上：它被反复取用（生成时判断合法性、输出答案、
    渲染），而题目是一棵不会变动的树，于是改成“算一次、处处复用”，父结点直接拿两个子
    结点的值做一次运算，不必每次从叶子重新自底向上算一遍。
    """

    op: str | None = None
    left: "Expression | None" = None
    right: "Expression | None" = None
    value: Fraction | None = None

    @staticmethod
    def leaf(value: Fraction) -> "Expression":
        return Expression(value=value)

    @staticmethod
    def branch(op: str, left: "Expression", right: "Expression") -> "Expression":
        if op == ADD:
            value = left.value + right.value
        elif op == SUB:
            value = left.value - right.value
        elif op == MUL:
            value = left.value * right.value
        else:
            value = left.value / right.value
        return Expression(op=op, left=left, right=right, value=value)

    @property
    def is_leaf(self) -> bool:
        return self.op is None

    # ------------------------------------------------------------------ 求值

    def evaluate(self) -> Fraction:
        """返回表达式的值（构造时已经算好）。"""
        return self.value

    def operator_count(self) -> int:
        if self.op is None:
            return 0
        return 1 + self.left.operator_count() + self.right.operator_count()

    # ------------------------------------------------------------------ 输出

    def render(self) -> str:
        """按题面格式输出表达式，只在必要处补括号。"""
        if self.op is None:
            return format_number(self.value)
        left = self._render_child(self.left, is_right=False)
        right = self._render_child(self.right, is_right=True)
        return f"{left} {self.op} {right}"

    def _render_child(self, child: "Expression", is_right: bool) -> str:
        text = child.render()
        if child.is_leaf:
            return text
        # 子表达式优先级更低时（如 (1 + 2) × 3）必须加括号。
        if PRECEDENCE[child.op] < PRECEDENCE[self.op]:
            return f"({text})"
        # 同级运算符：减法、除法不满足结合律，右子树必须加括号（如 5 − (3 − 1)）。
        if is_right and PRECEDENCE[child.op] == PRECEDENCE[self.op] and self.op in (SUB, DIV):
            return f"({text})"
        return text

    # ------------------------------------------------------------------ 判重

    def canonical(self) -> str:
        """返回表达式在交换律意义下的归一化字符串，用作判重的键。

        ``+`` 与 ``×`` 满足交换律，因此把左右子树的归一化结果按字典序排列后再拼接，
        使交换左右子树后的两棵树得到同一个键；``−``、``÷`` 不满足交换律，保持原序。
        """
        if self.op is None:
            return format_number(self.value)
        left, right = self.left.canonical(), self.right.canonical()
        if self.op in (ADD, MUL) and right < left:
            left, right = right, left
        return f"({left}{self.op}{right})"


# ---------------------------------------------------------------------- 解析器
# 兼容题面写法与手写的 ASCII 写法，使批改功能可以接受别人出的题目。
_TOKEN_PATTERN = re.compile(
    r"\d+\s*['’′]\s*\d+\s*/\s*\d+"  # 带分数 2’3/8
    r"|\d+\s*/\s*\d+"               # 真分数 3/5
    r"|\d+"                         # 自然数
    r"|[()+\-−*/×÷]"                # 括号与运算符
)


def evaluate_text(text: str) -> Fraction:
    """解析并计算表达式文本，供批改使用。

    这里刻意不复用生成端的表达式树：批改功能面对的是外部文件，应当独立地按题面文
    法解析一遍，从而验证题目文件本身是否规范、答案是否算得对。
    """
    tokens = [token.replace(" ", "") for token in _TOKEN_PATTERN.findall(text)]
    if not tokens:
        raise ValueError("没有找到任何数字或运算符")
    parser = _Parser(tokens)
    value = parser.parse_expression()
    if not parser.at_end():
        raise ValueError("表达式结构不完整")
    return value


class _Parser:
    """递归下降解析器。文法（与题面一致，同级运算符左结合）：

        expression = term (('+' | '−') term)*
        term       = factor (('×' | '÷') factor)*
        factor     = number | '(' expression ')'
    """

    _ADDITIVE = {"+", "-", "−"}
    _MULTIPLICATIVE = {"*", "×", "/", "÷"}

    def __init__(self, tokens: list[str]) -> None:
        self._tokens = tokens
        self._position = 0

    def at_end(self) -> bool:
        return self._position >= len(self._tokens)

    def _peek(self) -> str | None:
        return None if self.at_end() else self._tokens[self._position]

    def parse_expression(self) -> Fraction:
        value = self._parse_term()
        while self._peek() in self._ADDITIVE:
            operator = self._tokens[self._position]
            self._position += 1
            right = self._parse_term()
            value = value + right if operator == "+" else value - right
        return value

    def _parse_term(self) -> Fraction:
        value = self._parse_factor()
        while self._peek() in self._MULTIPLICATIVE:
            operator = self._tokens[self._position]
            self._position += 1
            right = self._parse_factor()
            value = value * right if operator in ("*", "×") else value / right
        return value

    def _parse_factor(self) -> Fraction:
        token = self._peek()
        if token is None:
            raise ValueError("表达式意外结束")
        if token == ")":
            raise ValueError("括号不匹配")
        if token == "(":
            self._position += 1
            value = self.parse_expression()
            if self._peek() != ")":
                raise ValueError("括号不匹配")
            self._position += 1
            return value
        self._position += 1
        return parse_number(token)


"""按题面约束随机生成不重复的题目。

生成策略是“先搭结构、再依值选运算符”的自底向上构造：先把运算符个数随机拆给左右子
树，递归构造出两棵子树并求出它们的值，最后在与这两个值相容的运算符里随机挑一个。
由于加法和乘法对操作数没有任何约束，候选集合永远非空，因此递归一定能终止，且每道
题目都恰好等于预定的运算符个数。
"""

from __future__ import annotations

import random
from dataclasses import dataclass
from fractions import Fraction

from .expression import ADD, DIV, MUL, OPERATORS, SUB, Expression
from .number import format_number

# 一道题目中运算符个数的上限，题面要求不超过 3 个。
MAX_OPERATORS = 3


class GenerationError(RuntimeError):
    """在给定的数值范围内无法生成足够多的不重复题目。"""


@dataclass(frozen=True)
class Problem:
    """一道四则运算题目。"""

    index: int
    expression: Expression

    @property
    def answer(self) -> Fraction:
        return self.expression.evaluate()

    def question_text(self) -> str:
        """题目文件中的一行，如 ``3 + 5 =``。"""
        return f"{self.expression.render()} ="

    def answer_text(self) -> str:
        """答案文件中的一行，如 ``7/24``。"""
        return format_number(self.answer)


def random_operand(r: int, rng: random.Random) -> Fraction:
    """在 [0, r) 中随机取一个自然数或真分数。

    题面规定“数值（自然数、真分数和真分数分母）的范围”由 -r 控制，即自然数小于 r，
    真分数的分子与分母也都小于 r。真分数以 1/2 的概率生成，避免小数值题目清一色是
    整数；另外这种等概率采样是 O(1) 的，不需要把整个取值池物化出来（r 较大时取值池
    是 O(r²) 的，物化会显著拖慢生成）。
    """
    numerator, denominator = random_pair(r, rng)
    return Fraction(numerator, denominator)


def random_pair(r: int, rng: random.Random) -> tuple[int, int]:
    """随机取一个操作数的 ``(分子, 分母)``，尚未约分。"""
    # r <= 2 时不存在分子分母都小于 r 的真分数，只能取自然数。
    if r > 2 and rng.random() < 0.5:
        denominator = rng.randrange(2, r)
        return rng.randrange(1, denominator), denominator
    return rng.randrange(0, r), 1


def is_legal(operator: str, left: Fraction, right: Fraction) -> bool:
    """判断一次运算是否符合题面约束。

    减法要求被减数不小于减数，保证计算过程中不出现负数；除法要求除数不为零、且被除
    数小于除数，保证商是真分数。
    """
    if operator == SUB:
        return _compare(left, right) >= 0
    if operator == DIV:
        # 除数不能为零，且被除数要小于除数，商才是真分数。
        return left != 0 and _compare(left, right) < 0
    return True


def _compare(left: Fraction, right: Fraction) -> int:
    """比较两个分数的大小，用整数交叉相乘，返回负数/0/正数。

    直接写 ``left < right`` 会走 ``Fraction`` 的 ``_richcmp``，其中包含大量类型判断和
    分支；交叉相乘只是两次整数乘法，在生成上万个题目、合法性判断被调用数万次时差别
    明显。
    """
    return left.numerator * right.denominator - right.numerator * left.denominator


def build_expression(operator_count: int, r: int, rng: random.Random) -> Expression:
    """构造一棵恰好含 ``operator_count`` 个运算符的表达式树。"""
    if operator_count == 0:
        return Expression.leaf(random_operand(r, rng))

    split = rng.randrange(operator_count)
    left_node = build_expression(split, r, rng)
    right_node = build_expression(operator_count - 1 - split, r, rng)

    left, right = left_node.value, right_node.value
    usable = [op for op in OPERATORS if is_legal(op, left, right)]
    return Expression.branch(rng.choice(usable), left_node, right_node)


class Generator:
    """题目生成器：一次运行生成的题目互不重复。"""

    def __init__(self, r: int, max_operators: int = MAX_OPERATORS, seed: int | None = None) -> None:
        if r < 1:
            raise ValueError("数值范围必须是自然数（>= 1）")
        if max_operators < 1:
            raise ValueError("运算符个数上限必须是自然数（>= 1）")
        self.r = r
        self.max_operators = max_operators
        # 使用独立的随机数发生器，便于测试时用固定种子复现。
        self.rng = random.Random(seed)

    def generate(self, count: int) -> list[Problem]:
        """生成 ``count`` 道不重复的题目。

        重复的判定用 :meth:`Expression.canonical` 归一化后比较，因此 ``23 + 45`` 与
        ``45 + 23``、``3 + (2 + 1)`` 与 ``1 + 2 + 3`` 都算同一道题。
        """
        if count < 1:
            raise ValueError("题目个数必须是自然数（>= 1）")

        problems: list[Problem] = []
        seen: set[str] = set()
        misses = 0
        # 连续多次都抽不到新题目，说明该范围内的不重复题目已接近穷尽。
        max_misses = max(10000, count * 10)

        while len(problems) < count:
            operator_count = self.rng.randint(1, self.max_operators)
            expression = build_expression(operator_count, self.r, self.rng)
            key = expression.canonical()
            if key in seen:
                misses += 1
                if misses >= max_misses:
                    raise GenerationError(
                        f"在 {self.r} 以内的数值范围中只能生成 {len(problems)} 道不重复的题目，"
                        f"无法满足生成 {count} 道的要求，请增大 -r 的值。"
                    )
                continue
            misses = 0
            seen.add(key)
            problems.append(Problem(len(problems) + 1, expression))
        return problems


"""批改：对照题目文件与答案文件，统计答对与答错的题号。"""

from __future__ import annotations

from .expression import evaluate_text
from .number import parse_number


class GradeError(RuntimeError):
    """题目文件不符合规范。"""


def grade(exercise_lines: list[str], answer_lines: list[str]) -> tuple[list[int], list[int]]:
    """逐行批改，返回 ``(答对的题号, 答错的题号)``。

    题号即行号，从 1 开始；空行跳过但占用题号，以免题号与题目错位。答案缺失或格式不
    正确一律记为该题答错——批改的是学生的答案，一个写错的答案不该让程序崩溃。
    """
    correct: list[int] = []
    wrong: list[int] = []

    for index, exercise in enumerate(exercise_lines, start=1):
        if not exercise.strip():
            continue
        try:
            expected = evaluate_text(exercise)
        except (ValueError, ZeroDivisionError) as error:
            raise GradeError(f"题目文件第 {index} 行不是规范的题目：{exercise.strip()}") from error

        answer = answer_lines[index - 1] if index <= len(answer_lines) else ""
        try:
            actual = parse_number(answer)
        except (ValueError, ZeroDivisionError):
            actual = None
        if actual is not None and actual == expected:
            correct.append(index)
        else:
            wrong.append(index)

    return correct, wrong


def format_report(correct: list[int], wrong: list[int]) -> str:
    """按题面要求的格式生成 Grade.txt 的内容。"""
    return (
        f"Correct: {len(correct)} ({', '.join(str(index) for index in correct)})\n"
        f"Wrong: {len(wrong)} ({', '.join(str(index) for index in wrong)})\n"
    )


"""数值的解析与格式化。

题面中数值有三种书写形式：

    自然数      3
    真分数      3/5        五分之三
    带分数      2’3/8      二又八分之三

本模块负责在 ``Fraction`` 与上述书写形式之间相互转换，供生成、输出、批改三个环节共用。
"""

from fractions import Fraction

# 带分数的分隔符。题面写作 U+2019，集中定义于此，若需改用 ASCII 撇号只需改这一处。
MIXED_SEPARATOR = "’"

# 解析时一并接受的其他撇号写法，便于用户手写答案。
_SEPARATOR_ALIASES = ("'", "’", "′")


def parse_number(text: str) -> Fraction:
    """把 ``3``、``3/5``、``2’3/8`` 解析为 Fraction。"""
    text = text.strip()
    for mark in _SEPARATOR_ALIASES:
        if mark in text:
            whole, _, fraction = text.partition(mark)
            sign = -1 if whole.strip().startswith("-") else 1
            return sign * (abs(int(whole.strip())) + _parse_fraction(fraction))
    return _parse_fraction(text)


def _parse_fraction(text: str) -> Fraction:
    text = text.strip()
    if "/" in text:
        numerator, _, denominator = text.partition("/")
        return Fraction(int(numerator.strip()), int(denominator.strip()))
    return Fraction(int(text))


def format_number(value: Fraction) -> str:
    """把 Fraction 格式化为题面要求的形式，假分数写成带分数。"""
    sign = "-" if value < 0 else ""
    numerator, denominator = abs(value.numerator), value.denominator
    if denominator == 1:
        return f"{sign}{numerator}"
    whole, remainder = divmod(numerator, denominator)
    if whole:
        return f"{sign}{whole}{MIXED_SEPARATOR}{remainder}/{denominator}"
    return f"{sign}{remainder}/{denominator}"


"""题目文件、答案文件与成绩文件的读写。

统一使用 UTF-8 编码：题目里含有 ``×``、``÷``、``−``、``’`` 等非 ASCII 字符，若沿用
Windows 默认的 GBK 编码，在别的机器上打开就会乱码。行尾统一写 ``\\n``，保证文件在不
同平台下的一致性。
"""

from __future__ import annotations

import os

ENCODING = "utf-8"
# 读取时用 utf-8-sig 以容忍别人用记事本另存时写进去的 BOM。
READ_ENCODING = "utf-8-sig"


def read_lines(path: str) -> list[str]:
    """按行读取文件，保留空行（空行会影响题目编号，不能丢弃）。"""
    try:
        with open(path, "r", encoding=READ_ENCODING) as handle:
            return [line.rstrip("\r\n") for line in handle]
    except FileNotFoundError as error:
        raise FileNotFoundError(f"找不到文件：{os.path.abspath(path)}") from error
    except UnicodeDecodeError as error:
        raise ValueError(f"文件不是 UTF-8 编码，无法读取：{path}") from error


def write_lines(path: str, lines: list[str]) -> None:
    """写入若干行，末尾补一个换行。"""
    write_text(path, "".join(f"{line}\n" for line in lines))


def write_text(path: str, text: str) -> None:
    with open(path, "w", encoding=ENCODING, newline="\n") as handle:
        handle.write(text)




"""Myapp 的单元测试。

运行：
    python -m unittest discover -s tests -v
"""

from __future__ import annotations

import os
import sys
import unittest
from fractions import Fraction

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from core.expression import ADD, DIV, MUL, SUB, Expression, evaluate_text  # noqa: E402
from core.generator import MAX_OPERATORS, GenerationError, Generator, is_legal  # noqa: E402
from core.grader import format_report, grade  # noqa: E402
from core.number import format_number, parse_number  # noqa: E402


def leaf(value: int | Fraction) -> Expression:
    return Expression.leaf(Fraction(value))


class NumberTests(unittest.TestCase):
    def test_parses_natural_number(self):
        self.assertEqual(parse_number("3"), Fraction(3))

    def test_parses_proper_fraction(self):
        self.assertEqual(parse_number("3/5"), Fraction(3, 5))

    def test_parses_mixed_number(self):
        self.assertEqual(parse_number("2’3/8"), Fraction(19, 8))

    def test_parses_mixed_number_with_ascii_apostrophe(self):
        self.assertEqual(parse_number("2'3/8"), Fraction(19, 8))

    def test_formats_natural_number(self):
        self.assertEqual(format_number(Fraction(3)), "3")

    def test_formats_proper_fraction(self):
        self.assertEqual(format_number(Fraction(3, 5)), "3/5")

    def test_formats_improper_fraction_as_mixed_number(self):
        self.assertEqual(format_number(Fraction(19, 8)), "2’3/8")

    def test_format_parse_round_trip(self):
        for value in (Fraction(0), Fraction(7), Fraction(3, 5), Fraction(19, 8)):
            self.assertEqual(parse_number(format_number(value)), value)


class ExpressionTests(unittest.TestCase):
    def test_evaluates_flat_expression(self):
        expression = Expression.branch(ADD, leaf(1), Expression.branch(ADD, leaf(2), leaf(3)))
        self.assertEqual(expression.evaluate(), Fraction(6))

    def test_renders_left_associative_chain_without_parentheses(self):
        expression = Expression.branch(ADD, Expression.branch(ADD, leaf(1), leaf(2)), leaf(3))
        self.assertEqual(expression.render(), "1 + 2 + 3")

    def test_renders_parentheses_around_lower_precedence_child(self):
        expression = Expression.branch(MUL, Expression.branch(ADD, leaf(1), leaf(2)), leaf(3))
        self.assertEqual(expression.render(), "(1 + 2) × 3")

    def test_renders_parentheses_around_right_sibling_of_subtraction(self):
        expression = Expression.branch(SUB, leaf(5), Expression.branch(SUB, leaf(3), leaf(1)))
        self.assertEqual(expression.render(), "5 − (3 − 1)")

    def test_operator_count(self):
        expression = Expression.branch(ADD, Expression.branch(ADD, leaf(1), leaf(2)), leaf(3))
        self.assertEqual(expression.operator_count(), 2)

    def test_canonical_ignores_operand_order_of_addition(self):
        left = Expression.branch(ADD, leaf(23), leaf(45))
        right = Expression.branch(ADD, leaf(45), leaf(23))
        self.assertEqual(left.canonical(), right.canonical())

    def test_canonical_ignores_nesting_of_addition(self):
        # 3 + (2 + 1) 与 1 + 2 + 3 应当判为同一道题。
        left = Expression.branch(ADD, leaf(3), Expression.branch(ADD, leaf(2), leaf(1)))
        right = Expression.branch(ADD, Expression.branch(ADD, leaf(1), leaf(2)), leaf(3))
        self.assertEqual(left.canonical(), right.canonical())

    def test_canonical_keeps_order_of_subtraction(self):
        left = Expression.branch(SUB, leaf(1), leaf(2))
        right = Expression.branch(SUB, leaf(2), leaf(1))
        self.assertNotEqual(left.canonical(), right.canonical())

    def test_canonical_distinguishes_different_chains(self):
        # 1 + 2 + 3 与 3 + 2 + 1 不是同一道题。
        left = Expression.branch(ADD, Expression.branch(ADD, leaf(1), leaf(2)), leaf(3))
        right = Expression.branch(ADD, Expression.branch(ADD, leaf(3), leaf(2)), leaf(1))
        self.assertNotEqual(left.canonical(), right.canonical())

    def test_evaluate_text_handles_precedence(self):
        self.assertEqual(evaluate_text("1 + 2 × 3 ="), Fraction(7))

    def test_evaluate_text_handles_parentheses(self):
        self.assertEqual(evaluate_text("(1 + 2) × 3 ="), Fraction(9))

    def test_evaluate_text_handles_fraction_answer(self):
        self.assertEqual(evaluate_text("1/6 + 1/8 ="), Fraction(7, 24))

    def test_evaluate_text_handles_mixed_number(self):
        self.assertEqual(evaluate_text("2’3/8 + 1/8 ="), Fraction(5, 2))

    def test_evaluate_text_rejects_malformed_expression(self):
