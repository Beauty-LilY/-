def all_operands(expression: Expression):
    if expression.is_leaf:
        yield expression.value
    else:
        yield from all_operands(expression.left)
        yield from all_operands(expression.right)


def all_operations(expression: Expression):
    """自底向上产出每一处子表达式的 ``(运算符, 左值, 右值)``。"""
    if expression.is_leaf:
        return
    for child in (expression.left, expression.right):
        yield from all_operations(child)
    yield expression.op, expression.left.evaluate(), expression.right.evaluate()


def all_values(expression: Expression):
    """产出所有操作数与中间结果，用于检查计算过程中不出现负数。"""
    if expression.is_leaf:
        yield expression.value
    else:
        yield from all_values(expression.left)
        yield from all_values(expression.right)
        yield expression.evaluate()


