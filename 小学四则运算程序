    unittest.main()



#!/usr/bin/env python3
"""小学四则运算题目自动生成与批改程序。

用法：
    python Myapp.py -n 10 -r 10              生成 10 道 10 以内的题目
    python Myapp.py -e Exercises.txt -a Answers.txt   批改

详细说明见 README.md。
"""

from __future__ import annotations

import argparse
import sys

from core.generator import MAX_OPERATORS, GenerationError, Generator
from core.grader import GradeError, format_report, grade
from core.storage import read_lines, write_lines, write_text

DEFAULT_COUNT = 10
EXERCISE_FILE = "Exercises.txt"
ANSWER_FILE = "Answers.txt"
GRADE_FILE = "Grade.txt"

EXIT_OK = 0
EXIT_USAGE = 2


def _enable_utf8_console() -> None:
    """让控制台以 UTF-8 输出。

    Windows 控制台默认是 GBK 代码页，而提示信息中含 ``−``、``×`` 等字符，不设置的话
    会显示成乱码甚至抛 UnicodeEncodeError。Python 3.7 起支持重配置标准输出流；若当前
    流不支持（例如被重定向到非文本对象），保持原样即可。
    """
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8")
        except (AttributeError, ValueError, OSError):
            pass

USAGE_EXAMPLES = """示例：
  python Myapp.py -n 10 -r 10
        生成 10 道 10 以内的四则运算题目，写入 Exercises.txt，答案写入 Answers.txt

  python Myapp.py -n 10000 -r 50
        批量生成 10000 道 50 以内的题目

  python Myapp.py -e Exercises.txt -a Answers.txt
        批改题目文件与答案文件，统计结果写入 Grade.txt"""


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="Myapp",
        description="小学四则运算题目自动生成与批改程序",
        epilog=USAGE_EXAMPLES,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("-n", type=int, default=DEFAULT_COUNT,
                        help=f"生成题目的个数，默认 {DEFAULT_COUNT}")
    parser.add_argument("-r", type=int, default=None,
                        help="题目中数值的范围（不包括该数本身），必填")
    parser.add_argument("-e", metavar="练习题目文件.txt",
                        help="批改模式下待批改的题目文件")
    parser.add_argument("-a", metavar="答案文件.txt",
                        help="批改模式下与题目文件对应的答案文件")
    parser.add_argument("--max-operators", type=int, default=MAX_OPERATORS,
                        help=f"每道题目的运算符个数上限，默认 {MAX_OPERATORS}")
    parser.add_argument("--seed", type=int, default=None,
                        help="随机种子，指定后可以复现同一批题目，便于测试")
    return parser


def run_generate(args: argparse.Namespace) -> int:
    generator = Generator(r=args.r, max_operators=args.max_operators, seed=args.seed)
    problems = generator.generate(args.n)
    write_lines(EXERCISE_FILE, [problem.question_text() for problem in problems])
    write_lines(ANSWER_FILE, [problem.answer_text() for problem in problems])
    print(f"已生成 {len(problems)} 道题目（数值范围：{args.r} 以内，运算符最多 {args.max_operators} 个）")
    print(f"题目文件：{EXERCISE_FILE}")
    print(f"答案文件：{ANSWER_FILE}")
    return EXIT_OK


def run_grade(args: argparse.Namespace) -> int:
    exercise_lines = read_lines(args.e)
    answer_lines = read_lines(args.a)
    correct, wrong = grade(exercise_lines, answer_lines)
    write_text(GRADE_FILE, format_report(correct, wrong))
    print(f"批改完成：共 {len(correct) + len(wrong)} 道题，"
          f"正确 {len(correct)} 道，错误 {len(wrong)} 道")
    print(f"成绩文件：{GRADE_FILE}")
    return EXIT_OK


def main(argv: list[str] | None = None) -> int:
    _enable_utf8_console()
    parser = build_parser()
    args = parser.parse_args(argv)

    grading = args.e is not None or args.a is not None
    if grading:
        if args.e is None or args.a is None:
            parser.error("批改模式需要同时给出 -e 和 -a 两个参数")
        if not args.e.lower().endswith(".txt") or not args.a.lower().endswith(".txt"):
            parser.error("题目文件和答案文件都应当是 .txt 文件")
        try:
            return run_grade(args)
        except (FileNotFoundError, ValueError, GradeError) as error:
            parser.error(str(error))
    else:
        # -r 是必需参数，缺失时给出帮助信息并以非零状态退出。
        if args.r is None:
            parser.error("参数 -r 是必需的，请指定数值范围，例如：python Myapp.py -n 10 -r 10")
        try:
            return run_generate(args)
        except (ValueError, GenerationError, OSError) as error:
            parser.error(str(error))

    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())


"""性能剖析脚本：统计生成 N 道题目的耗时，并输出最耗时的函数。

用法：
    python profile_generate.py            # 默认生成 10000 道题，范围 50
    python profile_generate.py 10000 50
"""

from __future__ import annotations

import cProfile
import io
import pstats
import random
import sys
import time
from fractions import Fraction

from core.generator import Generator

COUNT = int(sys.argv[1]) if len(sys.argv) > 1 else 10000
R = int(sys.argv[2]) if len(sys.argv) > 2 else 50


def work() -> int:
    """被测函数：生成题目并完成渲染，模拟真实的一次运行。"""
    problems = Generator(r=R, seed=2024).generate(COUNT)
    total = 0
    for problem in problems:
        total += len(problem.question_text()) + len(problem.answer_text())
    return total


def builtin_work() -> int:
    """对照实验：同样做 COUNT 次 Fraction 四则运算，但不做任何判重与渲染。"""
    rng = random.Random(2024)
    acc = Fraction(0)
    for _ in range(COUNT):
        acc += Fraction(rng.randrange(1, R), rng.randrange(1, R))
        acc -= Fraction(rng.randrange(1, R), rng.randrange(1, R))
    return acc.numerator


def measure(action, rounds: int = 3) -> float:
    """重复运行 ``action``，返回最快一轮的耗时（秒）。"""
    best = float("inf")
    for _ in range(rounds):
        start = time.perf_counter()
        action()
        best = min(best, time.perf_counter() - start)
    return best


def main() -> None:
    print(f"生成 {COUNT} 道题目，数值范围 {R} 以内")

    profiler = cProfile.Profile()
    profiler.enable()
    work()
    profiler.disable()

    stream = io.StringIO()
    stats = pstats.Stats(profiler, stream=stream).sort_stats("cumulative")
    stats.print_stats(15)
    print(stream.getvalue())

    print(f"生成 + 渲染：{measure(work) * 1000:.1f} ms")
    print(f"仅 Fraction 运算（对照）：{measure(builtin_work) * 1000:.1f} ms")


if __name__ == "__main__":
    main()

